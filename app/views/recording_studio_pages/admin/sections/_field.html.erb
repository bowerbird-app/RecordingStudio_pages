<% type = spec[:type].to_sym %>
<% name = "#{prefix}[#{key}]" %>
<% label = key.to_s.humanize %>

<% if type == :text || type == :rich_text %>
  <%= render FlatPack::TextArea::Component.new(name: name, label: label, value: value) %>
<% elsif type == :boolean %>
  <%= render FlatPack::Checkbox::Component.new(name: name, label: label, checked: value == true || value.to_s == "true") %>
<% elsif type == :integer %>
  <%= render FlatPack::NumberInput::Component.new(name: name, label: label, value: value) %>
<% elsif type == :url %>
  <%= render FlatPack::UrlInput::Component.new(name: name, label: label, value: value) %>
<% elsif type == :link %>
  <%= render FlatPack::TextInput::Component.new(name: "#{name}[text]", label: "#{label} text", value: value.is_a?(Hash) ? value["text"] : nil) %>
  <%= render FlatPack::UrlInput::Component.new(name: "#{name}[url]", label: "#{label} URL", value: value.is_a?(Hash) ? value["url"] : nil) %>
<% elsif type == :list %>
  <% Array(value).each_with_index do |item, index| %>
    <% (spec[:item] || {}).each do |item_key, item_spec| %>
      <%= render "recording_studio_pages/admin/sections/field",
                 prefix: "#{name}[#{index}]",
                 key: item_key,
                 spec: item_spec.is_a?(Hash) ? item_spec : { type: item_spec },
                 value: item.is_a?(Hash) ? item[item_key.to_s] : nil %>
    <% end %>
  <% end %>
  <% empty_index = Array(value).length %>
  <% (spec[:item] || {}).each do |item_key, item_spec| %>
    <%= render "recording_studio_pages/admin/sections/field",
               prefix: "#{name}[#{empty_index}]",
               key: item_key,
               spec: item_spec.is_a?(Hash) ? item_spec : { type: item_spec },
               value: nil %>
  <% end %>
<% else %>
  <%= render FlatPack::TextInput::Component.new(name: name, label: label, value: value) %>
<% end %>
