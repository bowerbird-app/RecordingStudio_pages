<% type = spec[:type].to_sym %>
<% name = "#{prefix}[#{key}]" %>
<% label = spec[:label].presence || key.to_s.humanize %>
<% disabled = local_assigns[:disabled] == true %>

<% if type == :cta %>
  <%= render "recording_studio_pages/admin/sections/cta_field",
             prefix: prefix,
             key: key,
             spec: spec,
             value: value %>
<% elsif type == :text || type == :rich_text %>
  <%= render FlatPack::TextArea::Component.new(name: name, label: label, value: value, disabled: disabled) %>
<% elsif type == :boolean %>
  <%= render FlatPack::Checkbox::Component.new(name: name, label: label, checked: value == true || value.to_s == "true", disabled: disabled) %>
<% elsif type == :integer %>
  <%= render FlatPack::NumberInput::Component.new(name: name, label: label, value: value, disabled: disabled) %>
<% elsif type == :url %>
  <%= render FlatPack::UrlInput::Component.new(name: name, label: label, value: value, disabled: disabled) %>
<% elsif type == :link %>
  <%= render FlatPack::TextInput::Component.new(name: "#{name}[text]", label: "#{label} text", value: value.is_a?(Hash) ? value["text"] : nil, disabled: disabled) %>
  <%= render FlatPack::UrlInput::Component.new(name: "#{name}[url]", label: "#{label} URL", value: value.is_a?(Hash) ? value["url"] : nil, disabled: disabled) %>
<% elsif type == :list %>
  <div class="flex flex-col gap-4">
    <% Array(value).each_with_index do |item, index| %>
      <div class="flex flex-col gap-3 rounded-[var(--radius-md)] border border-[var(--surface-border-color)] p-4">
        <p class="text-sm font-medium"><%= "#{label} #{index + 1}" %></p>
        <% (spec[:item] || {}).each do |item_key, item_spec| %>
          <%= render "recording_studio_pages/admin/sections/field",
                     prefix: "#{name}[#{index}]",
                     key: item_key,
                     spec: item_spec.is_a?(Hash) ? item_spec : { type: item_spec },
                     value: item.is_a?(Hash) ? item[item_key.to_s] : nil,
                     disabled: disabled %>
        <% end %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "#{name}[#{index}][_destroy]",
          label: "Remove this item",
          checked: false,
          disabled: disabled
        ) %>
      </div>
    <% end %>
    <% empty_index = Array(value).length %>
    <div class="flex flex-col gap-3 rounded-[var(--radius-md)] border border-dashed border-[var(--surface-border-color)] p-4">
      <p class="text-sm font-medium">Add <%= label.downcase.sub(/s$/, "") %></p>
      <% (spec[:item] || {}).each do |item_key, item_spec| %>
        <%= render "recording_studio_pages/admin/sections/field",
                   prefix: "#{name}[#{empty_index}]",
                   key: item_key,
                   spec: item_spec.is_a?(Hash) ? item_spec : { type: item_spec },
                   value: nil,
                   disabled: disabled %>
      <% end %>
    </div>
  </div>
<% elsif type == :recording_ids %>
  <%= render FlatPack::TextArea::Component.new(
    name: name,
    label: "#{label} (one id per line)",
    value: Array(value).join("\n"),
    disabled: disabled
  ) %>
<% else %>
  <%= render FlatPack::TextInput::Component.new(name: name, label: label, value: value, disabled: disabled) %>
<% end %>
