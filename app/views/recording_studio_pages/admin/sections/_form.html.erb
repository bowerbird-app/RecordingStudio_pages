<%= form_with url: url, method: method, local: true, html: { id: local_assigns[:form_id], novalidate: true } do %>
  <% content_values = definition.read_content(recordable&.content) %>
  <% settings_values = definition.read_settings(recordable&.settings) %>
  <% setting_fields = definition.settings.fields.except(:variant) %>
  <% ungrouped_settings = setting_fields.reject { |_key, spec| spec[:group].to_s == "style" } %>
  <% style_settings = setting_fields.select { |_key, spec| spec[:group].to_s == "style" } %>
  <%= hidden_field_tag "section[section_type]", definition.key %>
  <div class="flex flex-col gap-4" data-controller="recording-studio-pages--style-fields">
    <% definition.fields.fields.each do |key, spec| %>
      <%= render "recording_studio_pages/admin/sections/field",
                 prefix: "section[content]",
                 key: key,
                 spec: spec,
                 value: content_values[key.to_s],
                 section_recording: local_assigns[:section_recording] %>
    <% end %>

    <% if definition.variants.any? %>
      <%= render FlatPack::Select::Component.new(
        name: "section[settings][variant]",
        label: "Layout",
        value: settings_values["variant"] || definition.variants.first,
        options: definition.variants.map { |variant| [variant.humanize, variant] }
      ) %>
    <% end %>

    <% ungrouped_settings.each do |key, spec| %>
      <%= render "recording_studio_pages/admin/sections/setting_field",
                 key: key,
                 spec: spec,
                 value: settings_values[key.to_s],
                 settings_values: settings_values,
                 section_recording: local_assigns[:section_recording] %>
    <% end %>

    <% if style_settings.any? %>
      <%= render FlatPack::Divider::Component.new(label: "Style") %>
      <% style_settings.each do |key, spec| %>
        <% if spec[:show_when] %>
          <% show_when = spec[:show_when].to_h.symbolize_keys %>
          <div
            data-recording-studio-pages--style-fields-target="gated"
            data-show-when-variant="<%= show_when[:variant] %>"
            data-show-when-image="<%= show_when[:image] ? "true" : "false" %>"
            <% unless pages_setting_visible?(spec, settings: settings_values, content: content_values) %>hidden<% end %>>
            <%= render "recording_studio_pages/admin/sections/setting_field",
                       key: key,
                       spec: spec,
                       value: settings_values[key.to_s],
                       settings_values: settings_values,
                       section_recording: local_assigns[:section_recording] %>
          </div>
        <% else %>
          <%= render "recording_studio_pages/admin/sections/setting_field",
                     key: key,
                     spec: spec,
                     value: settings_values[key.to_s],
                     settings_values: settings_values,
                     section_recording: local_assigns[:section_recording] %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
