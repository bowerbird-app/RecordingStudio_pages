<% recording_studio_pages_nav(
     title: t("recording_studio.pages.sections.edit_title"),
     back_url: page_builder_page_path,
     anchor_url: RecordingStudioPages::Admin.admin_mount_path
   ) %>
<% section_form_id = "section-editor" %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @definition&.name || t("recording_studio.pages.sections.unknown"),
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <% if @definition %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio.pages.sections.update"),
        style: :primary,
        size: :md,
        type: :submit,
        form: section_form_id,
        data: { turbo: false }
      ) %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.pages.sections.cancel"),
      style: :default,
      size: :md,
      href: page_builder_page_path
    ) %>
  </div>

  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
    <div class="flex min-w-0 flex-col gap-6">
      <% if @definition %>
        <%= render "recording_studio_pages/admin/sections/form",
                   url: admin_page_section_path(page_id: page_recording.id, id: @section_recording.id),
                   method: :patch,
                   form_id: section_form_id,
                   definition: @definition,
                   recordable: @section_recording.recordable,
                   section_recording: @section_recording %>
        <% if @definition.child_types.any? %>
          <%= render "recording_studio_pages/admin/sections/children",
                     definition: @definition,
                     section_recording: @section_recording %>
        <% end %>
      <% else %>
        <%= render FlatPack::Alert::Component.new(
          style: :warning,
          title: t("recording_studio.pages.sections.unregistered_title"),
          description: t(
            "recording_studio.pages.sections.unregistered_description",
            section_type: @section_recording.recordable.section_type
          )
        ) %>
      <% end %>
    </div>
    <div class="min-w-0 md:sticky md:top-6">
      <% if @rendered_section&.component_class %>
        <div class="max-h-[80vh] overflow-auto rounded-[var(--radius-lg)] border border-[var(--surface-border-color)]">
          <%= render "recording_studio_pages/pages/section", rendered: @rendered_section %>
        </div>
      <% else %>
        <%= render FlatPack::Alert::Component.new(
          style: :info,
          title: t("recording_studio.pages.sections.nothing_preview_title"),
          description: t("recording_studio.pages.sections.nothing_preview_description")
        ) %>
      <% end %>
    </div>
  <% end %>
</div>
