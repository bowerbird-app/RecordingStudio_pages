<% recording_studio_pages_nav(
     title: t("recording_studio.pages.edit.title"),
     back_url: page_builder_page_path,
     anchor_url: RecordingStudioPages::Admin.admin_mount_path
   ) %>

<div class="flex w-full max-w-xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: t("recording_studio.pages.edit.title"), variant: :h1) %>

  <%= form_with url: admin_page_path(id: page_recording.id), method: :patch, local: true,
                class: "flex w-full flex-col gap-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "page[title]",
      label: t("recording_studio.pages.edit.name"),
      value: page_recording.recordable.title
    ) %>
    <%= render FlatPack::Checkbox::Component.new(
      name: "page[homepage]",
      label: t("recording_studio.pages.edit.homepage"),
      checked: page_recording.recordable.homepage?
    ) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(text: t("recording_studio.pages.edit.save"), style: :primary, size: :md, type: :submit) %>
    </div>
  <% end %>
</div>
