<% recording_studio_pages_nav(
     title: "Settings",
     back_url: page_builder_page_path,
     anchor_url: RecordingStudioPages::Admin.screen_path
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Settings", variant: :h1) %>

  <%= form_with url: admin_page_path(id: page_recording.id), method: :patch, local: true do %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "page[title]",
        label: "Name",
        value: page_recording.recordable.title
      ) %>
      <%= render FlatPack::Checkbox::Component.new(
        name: "page[homepage]",
        label: "Use as the public home page",
        checked: page_recording.recordable.homepage?
      ) %>
      <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, size: :md, type: :submit) %>
    </div>
  <% end %>

  <%= form_with url: admin_page_path(id: page_recording.id), method: :delete, local: true do %>
    <%= render FlatPack::Button::Component.new(
      text: "Remove page",
      style: :danger,
      size: :md,
      type: :submit
    ) %>
  <% end %>
</div>
