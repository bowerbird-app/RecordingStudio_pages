<% dummy_page_nav(title: "Edit page", back_url: page_builder_page_path) if defined?(dummy_page_nav) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Edit page", variant: :h1) %>

  <%= form_with url: admin_page_path(@page_recording), method: :patch, local: true do %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "page[title]",
        label: "Name",
        value: @page_recording.recordable.title
      ) %>
      <%= render FlatPack::Checkbox::Component.new(
        name: "page[homepage]",
        label: "Use as the public home page",
        checked: @page_recording.recordable.homepage?
      ) %>
      <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, size: :md, type: :submit) %>
    </div>
  <% end %>
</div>
