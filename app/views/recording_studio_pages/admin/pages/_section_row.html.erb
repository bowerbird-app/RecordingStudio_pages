<% recordable = recording.recordable %>
<% definition = RecordingStudioPages.find_section(recordable.section_type) %>
<% subtitle = recordable.enabled? ? (recordable.settings["variant"].presence || definition&.category) : "Off" %>
<% preview = recordable.content["title"].presence || recordable.content["body"].to_s.truncate(120) %>

<%= render FlatPack::List::Item.new(id: recording.id, leading: position.to_s, class: "!items-center") do %>
  <div class="flex w-full items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="font-medium"><%= definition&.name || recordable.section_type %></p>
      <% if subtitle.present? %>
        <p class="text-sm text-[var(--surface-muted-content-color)]"><%= subtitle %></p>
      <% end %>
      <% if preview.present? %>
        <p class="text-sm truncate"><%= preview %></p>
      <% end %>
    </div>
    <%= render "recording_studio_pages/admin/pages/section_actions",
               recording: recording,
               definition: definition,
               recordable: recordable %>
  </div>
<% end %>
