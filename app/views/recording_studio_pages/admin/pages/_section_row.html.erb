<% recordable = recording.recordable %>
<% definition = RecordingStudioPages.find_section(recordable.section_type) %>

<%= render FlatPack::List::Item.new(id: recording.id, icon: "arrows-up-down", hover: true, class: "!items-center") do %>
  <div class="flex w-full items-center justify-between gap-3">
    <% if definition %>
      <%= render FlatPack::Link::Component.new(
        href: edit_admin_page_section_path(page_id: page_recording.id, id: recording.id),
        class: "font-medium",
        data: { turbo_frame: "_top" }
      ) do %>
        <%= definition.name %>
      <% end %>
    <% else %>
      <p class="font-medium"><%= recordable.section_type %></p>
    <% end %>
    <%= render "recording_studio_pages/admin/pages/section_actions",
               recording: recording,
               definition: definition,
               recordable: recordable %>
  </div>
<% end %>
