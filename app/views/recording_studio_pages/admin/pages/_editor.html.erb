<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @page_recording.recordable.title,
    subtitle: @editor_subtitle,
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render "recording_studio_pages/admin/pages/add_section_dropdown" %>
    <% if defined?(RecordingStudioPublishable) %>
      <%= render_publishable_quick_actions(page_recording) %>
    <% end %>
    <%= render "recording_studio_pages/admin/pages/settings_dropdown" %>
  </div>

  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
    <div class="flex min-w-0 flex-col gap-6">
      <% if @unknown_sections.any? %>
        <%= render FlatPack::Alert::Component.new(
          style: :warning,
          title: t("recording_studio.pages.editor.unknown_sections_title"),
          description: t("recording_studio.pages.editor.unknown_sections_description")
        ) %>
      <% end %>

      <% if section_recordings.any? %>
        <%= render FlatPack::Card::Component.new(padding: :md) do %>
          <div data-controller="recording-studio-pages--section-list">
            <%= render FlatPack::List::Component.new(
              ordered: false,
              orderable: true,
              orderable_url: reorder_admin_page_sections_path(page_id: page_recording.id),
              orderable_method: :patch,
              param_uuid_name: "moving_recording_id",
              param_target_position_name: "target_position",
              divider: true
            ) do %>
              <% section_recordings.each do |recording| %>
                <%= render "recording_studio_pages/admin/pages/section_row", recording: recording %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(
          title: t("recording_studio.pages.editor.empty_sections_title"),
          description: t("recording_studio.pages.editor.empty_sections_description")
        ) %>
      <% end %>
    </div>
    <div class="min-w-0 md:sticky md:top-6">
      <% if @rendered_sections.present? %>
        <div class="max-h-[80vh] overflow-auto rounded-[var(--radius-lg)] border border-[var(--surface-border-color)]">
          <%= render "recording_studio_pages/pages/sections" %>
        </div>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(
          title: t("recording_studio.pages.editor.preview_title"),
          description: t("recording_studio.pages.editor.preview_description")
        ) %>
      <% end %>
    </div>
  <% end %>
</div>
