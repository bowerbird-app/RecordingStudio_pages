<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @page_recording.recordable.title,
    subtitle: @editor_subtitle,
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render "recording_studio_pages/admin/pages/add_section_dropdown" %>
    <%= render "recording_studio_pages/admin/pages/add_template_dropdown" %>
    <%= render FlatPack::Button::Component.new(
      text: "Settings",
      href: edit_admin_page_path(id: page_recording.id),
      style: :secondary,
      size: :md,
      data: { turbo_frame: "_top" }
    ) %>
    <% if defined?(RecordingStudioPublishable) %>
      <%= render_publishable_quick_actions(page_recording) %>
    <% end %>
  </div>

  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
    <div class="flex min-w-0 flex-col gap-6">
      <% if @unknown_sections.any? %>
        <%= render FlatPack::Alert::Component.new(
          style: :warning,
          title: "Some sections are waiting on a missing type",
          description: "Their content is still saved. Register the section type to edit them again."
        ) %>
      <% end %>

      <% if section_recordings.any? %>
        <%= render FlatPack::Card::Component.new(padding: :md) do %>
          <div data-controller="recording-studio-pages--section-list">
            <%= render FlatPack::List::Component.new(
              ordered: true,
              orderable: true,
              orderable_url: reorder_admin_page_sections_path(page_id: page_recording.id),
              orderable_method: :patch,
              param_uuid_name: "moving_recording_id",
              param_target_position_name: "target_position",
              divider: true,
              class: "list-decimal pl-6"
            ) do %>
              <% section_recordings.each_with_index do |recording, index| %>
                <%= render "recording_studio_pages/admin/pages/section_row", recording: recording, position: index + 1 %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(
          title: "Add your first section",
          description: "Open Section and pick a type."
        ) %>
      <% end %>
    </div>
    <div class="min-w-0 md:sticky md:top-6">
      <% if @rendered_sections.present? %>
        <div class="max-h-[80vh] overflow-auto rounded-[var(--radius-lg)] border border-[var(--surface-border-color)]">
          <%= render "recording_studio_pages/pages/sections" %>
        </div>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(
          title: "Preview",
          description: "Turn a section on and it shows up here."
        ) %>
      <% end %>
    </div>
  <% end %>
</div>
