<% dummy_page_nav(title: "Pages", back_url: "/admin") if defined?(dummy_page_nav) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages",
    subtitle: "Compose a public page from registered sections.",
    variant: :h1
  ) %>

  <%= render FlatPack::Button::Component.new(
    text: "New page",
    href: new_admin_page_path,
    style: :primary,
    size: :md
  ) %>

  <% if @page_recordings.empty? %>
    <%= render FlatPack::Alert::Component.new(
      type: :info,
      title: "Nothing here yet",
      message: "Add a page to get going."
    ) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @page_recordings, class: "text-sm") do |table| %>
      <% table.column(title: "Page") { |recording| recording.recordable&.title } %>
      <% table.column(title: "Home") { |recording| recording.recordable&.homepage? ? "Home" : "" } %>
      <% table.column(title: "") { |recording| link_to("Open", admin_page_path(recording)) } %>
    <% end %>
  <% end %>
</div>
