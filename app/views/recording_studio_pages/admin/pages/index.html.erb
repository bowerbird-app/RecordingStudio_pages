<% recording_studio_pages_nav(
     title: "Pages",
     back_url: RecordingStudioPages::Admin.admin_mount_path,
     anchor_url: RecordingStudioPages::Admin.admin_mount_path
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages",
    subtitle: "Compose a public page from registered sections.",
    variant: :h1
  ) do |page_title| %>
    <% page_title.slot do %>
      <%= render FlatPack::Button::Component.new(
        text: "Page",
        icon: "plus",
        href: new_admin_page_path,
        style: :primary,
        size: :md
      ) %>
    <% end %>
  <% end %>

  <% if @page_recordings.empty? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: "Nothing here yet",
      description: "Add a page to get going."
    ) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @page_recordings, class: "text-sm") do |table| %>
      <% table.column(title: "Page") { |recording| recording.recordable&.title } %>
      <% table.column(title: "Home") { |recording| recording.recordable&.homepage? ? "Home" : "" } %>
      <% table.column(title: "") { |recording|
        render FlatPack::Button::Component.new(
          text: "Open",
          href: admin_page_path(recording),
          style: :secondary,
          size: :sm
        )
      } %>
    <% end %>
  <% end %>
</div>
