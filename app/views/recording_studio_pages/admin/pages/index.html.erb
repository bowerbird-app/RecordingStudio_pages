<% recording_studio_pages_nav(
     title: RecordingStudio.t("recording_studio.pages.index.title"),
     subtitle: RecordingStudio.t("recording_studio.pages.index.subtitle"),
     back_url: RecordingStudioPages::Admin.admin_mount_path,
     anchor_url: RecordingStudioPages::Admin.admin_mount_path
   ) %>
<% if respond_to?(:register_page_nav) %>
  <% register_page_nav(
       RecordingStudio.t("recording_studio.pages.index.new_page"),
       new_admin_page_path,
       role: :primary,
       icon: "plus"
     ) %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <% if @page_recordings.empty? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: RecordingStudio.t("recording_studio.pages.index.empty_title"),
      description: RecordingStudio.t("recording_studio.pages.index.empty_description")
    ) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @page_recordings, class: "text-sm") do |table| %>
      <% table.column(title: RecordingStudio.t("recording_studio.pages.index.column_page")) { |recording|
        title = recording.recordable&.title
        home = recording.recordable&.homepage? ? RecordingStudio.t("recording_studio.pages.index.home_badge") : nil
        home = nil if home.present? && home == title
        safe_join(
          [
            link_to(title, admin_page_path(recording), class: "font-medium text-[var(--surface-content-color)]"),
            (tag.span(home, class: "text-[var(--surface-muted-content-color)]") if home)
          ].compact,
          " · "
        )
      } %>
    <% end %>
  <% end %>
</div>
