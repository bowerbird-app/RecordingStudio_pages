<% recording_studio_pages_nav(title: "New page", back_url: admin_pages_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "New page",
    subtitle: "Give it a name. You can add sections next.",
    variant: :h1
  ) %>

  <%= form_with url: admin_pages_path, method: :post, local: true do %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "page[title]",
        label: "Name",
        value: params.dig(:page, :title)
      ) %>
      <%= render FlatPack::Checkbox::Component.new(
        name: "page[homepage]",
        label: "Use as the public home page"
      ) %>
      <% if RecordingStudioPages.templates.any? %>
        <%= render FlatPack::Select::Component.new(
          name: "page[template_key]",
          label: "Start from a template",
          placeholder: "Empty page",
          options: RecordingStudioPages.templates.map { |template| [template.name, template.key] }
        ) %>
      <% end %>
      <%= render FlatPack::Button::Component.new(text: "Create page", style: :primary, size: :md, type: :submit) %>
    </div>
  <% end %>
</div>
