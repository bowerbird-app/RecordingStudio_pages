<% section_definitions.each do |definition| %>
  <%= form_with url: admin_page_sections_path(page_id: page_recording.id),
                method: :post,
                html: { id: add_section_form_id(definition), class: "hidden" },
                data: { turbo_frame: "page_editor" } do %>
    <%= hidden_field_tag "section[section_type]", definition.key %>
  <% end %>
<% end %>

<%= render FlatPack::Button::Dropdown::Component.new(
  text: "Add section",
  style: :primary,
  size: :md,
  placement: :bottom_left
) do |dropdown| %>
  <% section_definitions.each do |definition| %>
    <% dropdown.menu_item(
      text: definition.name,
      form: add_section_form_id(definition),
      type: "submit"
    ) %>
  <% end %>
<% end %>
