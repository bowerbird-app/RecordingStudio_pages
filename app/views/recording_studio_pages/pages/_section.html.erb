<% component_class = rendered.component_class %>
<% if component_class %>
  <% kwargs = { rendered: rendered } %>
  <% kwargs[:overlay] = local_assigns.fetch(:overlay, false) if rendered.definition.key.to_s == "top_nav" %>
  <% if rendered.definition.full_bleed? %>
    <%= render component_class.new(**kwargs) %>
  <% else %>
    <div class="mx-auto w-full max-w-6xl px-6 py-8">
      <%= render component_class.new(**kwargs) %>
    </div>
  <% end %>
<% end %>
