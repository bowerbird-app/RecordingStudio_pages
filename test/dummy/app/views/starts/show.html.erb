<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-16">
  <% if @url.present? %>
    <%= render FlatPack::PageTitle::Component.new(
          title: "Got it",
          subtitle: @url,
          variant: :h1
        ) %>
  <% else %>
    <%= render FlatPack::PageTitle::Component.new(
          title: "Nothing in the box yet",
          subtitle: "Paste a link on the page and try again.",
          variant: :h1
        ) %>
  <% end %>
</div>
