<%# Dummy keeps the plus icon on the Pages "Page" hub link. %>
<% access_recording = recording_studio_admin_context.root_recording || recording_studio_admin_context.access_recording %>
<% recording_studio_admin_page_heading(
     title: @section.title,
     anchor: page_nav_anchor_url(default: RecordingStudioAdmin.configuration.default_mount_path),
     subtitle: @section.subtitle
   ) %>
<% if access_recording.present? %>
  <% recording_studio_page_nav_right do %>
    <%= recording_studio_accessible_avatars(access_recording, button_style: :ghost, button_size: :md) %>
  <% end %>
<% end %>
<% action_links = @section.links.reject { |link| link.text == "Admin Sections" } %>
<% action_links.each_with_index do |link, index| %>
  <% register_page_nav(
       link.text,
       preserve_anchor_url(link.url),
       role: recording_studio_admin_page_nav_role(link.style),
       overflow: index >= 3,
       icon: (link.name.to_s == "new_page" ? "plus" : nil)
     ) %>
<% end %>
<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% unless recording_studio_admin_default_layout? %>
    <%= render "recording_studio_admin/shared/page_nav" %>
    <%= render FlatPack::PageTitle::Component.new(title: @section.title, subtitle: @section.subtitle) %>
  <% end %>

  <% if @section.widgets.any? %>
    <% compact_widgets, full_widgets = @section.widgets.partition { |widget| widget.view_variant == :compact } %>
    <% widget_grid_gap = :md %>

    <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
      <div data-controller="recording-studio-admin--async-widgets"
           data-recording-studio-admin--async-widgets-max-concurrent-value="<%= RecordingStudioAdmin.configuration.async_widgets.max_concurrent_requests %>"
           data-recording-studio-admin--async-widgets-retry-count-value="<%= RecordingStudioAdmin.configuration.async_widgets.retry_count %>">
    <% end %>

    <% if compact_widgets.any? %>
      <%= render FlatPack::Grid::Component.new(cols: 3, gap: widget_grid_gap, class: "my-4") do %>
        <% compact_widgets.each do |widget| %>
          <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
            <%= render_recording_studio_async_widget_frame(widget, parent: :section, parent_key: @section.key) %>
          <% else %>
            <%= render_recording_studio_widget(widget) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if full_widgets.any? %>
      <%= render FlatPack::Grid::Component.new(cols: 3, gap: widget_grid_gap, class: (compact_widgets.any? ? "my-4" : "my-8")) do %>
        <% full_widgets.each do |widget| %>
          <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
            <%= render_recording_studio_async_widget_frame(widget, parent: :section, parent_key: @section.key) %>
          <% else %>
            <%= render_recording_studio_widget(widget) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
      </div>
    <% end %>
  <% end %>
<% end %>
